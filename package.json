{
  "name": "mascot-studio",
  "version": "1.1.1",
  "private": true,
  "description": "Original SVG mascots that feel alive: real rigs, clean lines, 60 fps motion, zero dependencies.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "vite playground",
    "build": "vite build playground --outDir ../dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:scripts": "node --test scripts/*.test.mjs",
    "check": "node tools/check.mjs",
    "check:styles": "node tools/distinct.mjs",
    "docs:styles": "node scripts/style-docs.mjs",
    "build:gallery": "node tools/build-gallery.mjs",
    "build:embed": "node tools/build-embed.mjs",
    "build:site": "node tools/build-site.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
